  "info": {
    "description": "RMG platform pilot API — {data, meta} envelope on success, RFC 9457 problem+json on errors.",
    "title": "Rmg.Api",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "PostAuthLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOfLoginResult"
                }
              }
            },
            "description": "Success"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Error — RFC 9457 problem+json (code, errors[], correlationId)"
          }
        }
      }
    },
