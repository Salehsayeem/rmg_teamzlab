          "DisplayName",
          "Email",
          "Password"
        ],
        "type": "object"
      },
      "UserDto": {
        "properties": {
          "DisplayName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Id": {
            "format": "uuid",
