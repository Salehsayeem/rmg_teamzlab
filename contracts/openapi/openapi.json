            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "Qty"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "description": "stable machine-readable error code",
            "type": "string"
          },
          "correlationId": {
            "description": "correlation id echoed by CorrelationMiddleware",
            "type": "string"
          },
          "detail": {
            "nullable": true,
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "per-field validation messages, when the problem is a validation failure",
            "type": "object"
          },
          "instance": {
            "format": "uri-reference",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
